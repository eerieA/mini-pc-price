# Local credentials for `python src/digest.py` (plan.md §6).
#
# Copy to `.env` and fill in. `.env` is git-ignored; this template is committed
# and must never carry a real value.
#
#   cp .env.example .env
#
# digest.py reads `.env` automatically when it is present. Variables already set
# in the real environment WIN over this file, so a scheduled task that sets them
# properly is not overridden by a stale .env left in the working directory.
#
# This file is for local testing. For a scheduled run, set real user environment
# variables instead (System Properties > Environment Variables, or `setx`) --
# nothing then depends on the working directory.

# The Gmail address that authenticates to SMTP.
MINIPC_SMTP_USER=you@gmail.com

# A Google App Password -- 16 characters, usually shown in four groups of four.
# NOT your account password. Requires 2-Step Verification on the account;
# issue one at https://myaccount.google.com/apppasswords
# Spaces are fine, quotes are optional and stripped if present.
MINIPC_SMTP_PASS=xxxx xxxx xxxx xxxx

# Where the digest goes. May be the same address as MINIPC_SMTP_USER.
# Overrides `to:` in config/digest.yaml when set.
MINIPC_DIGEST_TO=you@gmail.com
